// GHT Promoções — schema pré-montado (Fase 8, ainda SEM banco conectado).
// Espelha os tipos do domínio em src/features/deals/types.ts — manter em
// sincronia. `isMock` não existe aqui de propósito: dados do banco são reais;
// o mapeamento no PrismaDealsRepository define isMock: false.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: a connection URL não vive mais aqui — migrations usam
// prisma.config.ts e o runtime usa driver adapter no PrismaClient
// (src/server/prisma.ts), ambos lendo DATABASE_URL.
datasource db {
  provider = "postgresql"
}

/// Usuário do painel /admin (rota oculta). Senha com scrypt — nunca em claro.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// "owner" gerencia os demais admins (tela /admin/admins); default "admin".
  role         String   @default("admin")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

/// Denúncia de oferta enviada pelo público na página de detalhe do produto.
model Report {
  id        String   @id @default(cuid())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  dealId    String   @map("deal_id")
  /// preco-incorreto | oferta-inexistente | problema-produto | outro
  reason    String
  details   String?
  /// aberto | resolvido
  status    String   @default("aberto")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("reports")
}

model Category {
  slug        String    @id
  name        String
  description String
  products    Product[]

  @@map("categories")
}

model Store {
  id      String @id
  name    String
  iconUrl String @map("icon_url")
  deals   Deal[]

  @@map("stores")
}

model Product {
  id           String   @id @default(cuid())
  title        String
  /// Descrição curta exibida no card/JSON-LD. Nula quando a fonte não informa.
  description  String?
  imageUrl     String   @map("image_url")
  category     Category @relation(fields: [categorySlug], references: [slug])
  categorySlug String   @map("category_slug")
  deals        Deal[]

  @@index([categorySlug])
  @@map("products")
}

model Deal {
  id           String   @id @default(cuid())
  product      Product  @relation(fields: [productId], references: [id])
  productId    String   @map("product_id")
  store        Store    @relation(fields: [storeId], references: [id])
  storeId      String   @map("store_id")
  /// Preço atual em BRL.
  price        Decimal  @db.Decimal(10, 2)
  /// Preço anterior ("de"), exibido riscado. Nulo quando a fonte não informa.
  oldPrice     Decimal? @map("old_price") @db.Decimal(10, 2)
  /// Desconto percentual inteiro (derivado de price/oldPrice na escrita).
  discountPct  Int?     @map("discount_pct")
  affiliateUrl String   @map("affiliate_url")
  featured     Boolean  @default(false)
  /// Origem da oferta: "awin" (feed, expirada pelo cron), "manual" (painel
  /// admin — o cron nunca toca) ou "demo" (seed de demonstração).
  source       String   @default("awin")
  /// Validade de oferta manual; nula = sem validade. Consultas públicas
  /// excluem ofertas vencidas.
  expiresAt    DateTime? @map("expires_at")
  /// Forma de pagamento anunciada (ex.: "à vista no Pix"); só ofertas manuais.
  paymentInfo  String?   @map("payment_info")
  /// Código de cupom da oferta, quando houver; só ofertas manuais.
  couponCode   String?   @map("coupon_code")
  reports      Report[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([storeId])
  @@index([featured])
  @@index([source])
  @@map("deals")
}
