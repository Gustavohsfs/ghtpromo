# Fonte de dados da vitrine: "mock" (default) | "prisma" (Fase 8, requer banco)
DATA_SOURCE=mock

# URL canonica do site (SEO). Em producao, configure na Vercel.
NEXT_PUBLIC_SITE_URL=https://ghtpromo.com.br

# Crawlers de IA no robots.txt: "true" (default) permite GPTBot, ClaudeBot,
# PerplexityBot e Google-Extended; "false" bloqueia.
ALLOW_AI_CRAWLERS=true

# Conexao PostgreSQL (obrigatoria apenas com DATA_SOURCE=prisma).
# Usada pelo CLI (prisma.config.ts) e pelo runtime (src/server/prisma.ts).
# DATABASE_URL="postgresql://usuario:senha@localhost:5432/ghtpromo"

# Chave geral de indexacao: "true" (default) = site indexavel; "false" =
# noindex/nofollow + robots.txt bloqueando tudo. Recomendado "false" na Vercel
# ENQUANTO a vitrine estiver com dados de demonstracao; troque para "true"
# (ou remova) no lancamento com dados reais.
ALLOW_INDEXING=true
